<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/notification_banner_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Top rectangular header row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="4dp"
            android:layout_height="14dp"
            android:background="#10B981" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="NutriTrack"
            android:textColor="#34D399"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_expanded_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/notification_chip_bg"
            android:paddingHorizontal="7dp"
            android:paddingVertical="1.5dp"
            android:text="✨ Smart Companion"
            android:textColor="#A7F3D0"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="Active"
            android:textColor="#64748B"
            android:textSize="10.5sp" />
    </LinearLayout>

    <!-- Main Title -->
    <TextView
        android:id="@+id/notif_expanded_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:text="Welcome to NutriTrack! 🥗"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Rectangular Animated Ticker / Feature Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/notification_ticker_bg"
        android:orientation="horizontal"
        android:padding="8dp">

        <ImageView
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:background="#10B981" />

        <ViewFlipper
            android:id="@+id/notif_view_flipper"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:autoStart="true"
            android:flipInterval="3000"
            android:inAnimation="@android:anim/fade_in"
            android:outAnimation="@android:anim/fade_out">

            <!-- Slide 1 -->
            <TextView
                android:id="@+id/notif_slide_1_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🥗 Track calories, protein, carbs, fats &amp; hydration with ease."
                android:textColor="#E2E8F0"
                android:textSize="12sp" />

            <!-- Slide 2 -->
            <TextView
                android:id="@+id/notif_slide_2_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚡ Barcode Scanner, Indian Recipes &amp; Custom Meal Builder."
                android:textColor="#A7F3D0"
                android:textSize="12sp" />

            <!-- Slide 3 -->
            <TextView
                android:id="@+id/notif_slide_3_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📈 3-Month Future Weight Prediction &amp; Multi-Device Sync."
                android:textColor="#6EE7B7"
                android:textSize="12sp" />

            <!-- Slide 4 -->
            <TextView
                android:id="@+id/notif_slide_4_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔥 Build streaks, conquer diet goals &amp; stay fit every day!"
                android:textColor="#FDE047"
                android:textSize="12sp" />
        </ViewFlipper>
    </LinearLayout>

    <!-- Subtitle / Descriptive message -->
    <TextView
        android:id="@+id/notif_expanded_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="Tap below to explore your personalized dashboard and log your first meal."
        android:textColor="#94A3B8"
        android:textSize="11.5sp" />

    <!-- Action Row with Rectangular Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/notif_btn_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/notification_rect_button"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="Open NutriTrack ➔"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:gravity="end"
            android:text="Ready to track"
            android:textColor="#64748B"
            android:textSize="10.5sp" />
    </LinearLayout>
</LinearLayout>
